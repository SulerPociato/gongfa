{
  "name": "gongfa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @gongfa/web dev",
    "dev:server": "node server/index.mjs",
    "build": "pnpm --filter @gongfa/web build",
    "serve": "node server/index.mjs",
    "start": "node server/index.mjs",
    "sim": "tsx tools/balance-sim.ts",
    "sim:table": "tsx tools/balance-sim.ts --table",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/blocks/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "audit:balance": "tsx tools/audit-balance.ts",
    "audit:fuzz": "tsx tools/audit-fuzz.ts"
  },
  "devDependencies": {
    "@gongfa/core": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
